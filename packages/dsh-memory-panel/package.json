{
  "name": "@restregular/dsh-memory-panel",
  "version": "0.1.0",
  "description": "DSH 记忆面板：设置页里浏览/搜索/编辑/删除记忆，并手动启停本地向量服务。",
  "icon": "./icon.svg",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@restregular/dsh-memory": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@restregular/dsh-memory": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RestRegular/dsh-memory",
    "directory": "packages/dsh-memory-panel"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "panel",
    "settings"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
